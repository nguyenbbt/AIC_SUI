# Offline Phase - external providers and local infrastructure
# Module 3 - Gemini transcript cleaning and summarization
GEMINI_API_KEY=

# Module 3 - Azure OpenAI transcript cleaning and summarization
OPENAI_API_KEY=
BASE_URL=https://your-resource.openai.azure.com
API_VERSION=2024-08-01-preview

# Local Docker / m-gpux Compose - MinIO development credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Online Phase - read-only self-indexed-v2 consumers
AIC_ONLINE_MILVUS_URI=http://localhost:19530
AIC_ONLINE_MILVUS_ALIAS=online
AIC_ONLINE_MILVUS_VISUAL_COLLECTION=visual_features
AIC_ONLINE_MILVUS_OCR_COLLECTION=ocr_features
AIC_ONLINE_MILVUS_ASR_COLLECTION=asr_features
AIC_ONLINE_MILVUS_SUMMARY_COLLECTION=summary_features
AIC_ONLINE_MILVUS_SEARCH_EF=128
AIC_ONLINE_MILVUS_TIMEOUT_SEC=5
AIC_ONLINE_VECTOR_NORM_TOLERANCE=0.001

AIC_ONLINE_ES_URI=http://localhost:9200
AIC_ONLINE_ES_OCR_INDEX=ocr_texts
AIC_ONLINE_ES_ASR_INDEX=asr_transcripts
AIC_ONLINE_ES_SUMMARY_INDEX=video_summaries
AIC_ONLINE_ES_TIMEOUT_SEC=5
AIC_ONLINE_ES_FUZZY_ENABLED=false
AIC_ONLINE_ES_FUZZINESS=AUTO
AIC_ONLINE_ES_EVIDENCE_LOOKUP_LIMIT=1000

AIC_ONLINE_SQLITE_PATH=data/metadata.db
AIC_ONLINE_SQLITE_VIDEOS_TABLE=videos
AIC_ONLINE_SQLITE_METADATA_TABLE=metadata
AIC_ONLINE_SQLITE_OBJECTS_TABLE=objects
AIC_ONLINE_SQLITE_BATCH_SIZE=500
AIC_ONLINE_SQLITE_TIMEOUT_SEC=5

# One atomically published self-indexed-v2 dataset. Production must pin the
# exact sha256 fingerprint received from Offline.
AIC_ONLINE_DATASET_MANIFEST_PATH=data/processed/dataset-manifest.json
AIC_ONLINE_DATA_ROOT=data
AIC_ONLINE_DATASET_CONTRACT_VERSION=self-indexed-v2
AIC_ONLINE_DATASET_EXPECTED_FINGERPRINT=
AIC_ONLINE_DATASET_MANIFEST_REQUIRED=true
AIC_ONLINE_DATASET_AUDIT_BATCH_SIZE=500

# TRAKE can be enabled with the data adapters above. VQA additionally requires
# an explicitly injected production VLMPort; startup rejects VQA otherwise.
AIC_ONLINE_TRAKE_ENABLED=false
AIC_ONLINE_VQA_ENABLED=false
